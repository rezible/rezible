{
  "worktree": {
    "setup": [
      "cp \"$PASEO_SOURCE_CHECKOUT_PATH/.env\" .env",
      "devbox run -q setup"
    ],
    "teardown": "devbox run -q teardown"
  },
  "scripts": {
    "frontend": {
      "type": "service",
      "command": "./devenv/scripts/paseo-run frontend::dev"
    },
    "backend": {
      "type": "service",
      "command": "./devenv/scripts/paseo-run backend::dev"
    },
    "backend-tests": {
      "type": "script",
      "command": "devbox run -q -- just test backend"
    },
    "documents": {
      "type": "service",
      "command": "./devenv/scripts/paseo-run documents-server::dev"
    }
  }
}
