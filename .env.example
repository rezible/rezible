# Copy to .env. Devbox loads it into every shell and recipe (`env_from` in devbox.json).
# Workspace setup generates the rest of the development configuration in devenv/.workspace-env.sh.

# --- Required ---------------------------------------------------------------------------------------------

# Slack incoming webhook for the devenv Alertmanager (`just dev infra-up alertmanager`, `just sim`).
SLACK_WEBHOOK_URL=

# --- Optional: model provider -----------------------------------------------------------------------------

# Investigations, the model situation judge and agent evaluations need a model provider.
# AI__GEMINI__ENABLED=true
# AI__GEMINI__API_KEY=
# Or Claude (enable one provider). AI__ANTHROPIC__MODEL defaults to claude-haiku-5-5.
# AI__ANTHROPIC__ENABLED=true
# AI__ANTHROPIC__API_KEY=
# AI__ANTHROPIC__MODEL=claude-haiku-5-5

# --- Optional: integrations -------------------------------------------------------------------------------

# Slack agent app.
# INTEGRATIONS__SLACK__AGENT__ENABLED=true
# INTEGRATIONS__SLACK__AGENT__OAUTH_CLIENT_ID=
# INTEGRATIONS__SLACK__AGENT__OAUTH_CLIENT_SECRET=
# INTEGRATIONS__SLACK__AGENT__WEBHOOK_SIGNING_SECRET=

# Slack incidents app.
# INTEGRATIONS__SLACK__INCIDENTS__ENABLED=true
# INTEGRATIONS__SLACK__INCIDENTS__OAUTH_CLIENT_ID=
# INTEGRATIONS__SLACK__INCIDENTS__OAUTH_CLIENT_SECRET=
# INTEGRATIONS__SLACK__INCIDENTS__WEBHOOK_SIGNING_SECRET=

# GitHub app.
# INTEGRATIONS__GITHUB__ENABLED=true
# INTEGRATIONS__GITHUB__WEBHOOK_SECRET=
# INTEGRATIONS__GITHUB__APP__APP_ID=
# INTEGRATIONS__GITHUB__APP__SLUG=
# INTEGRATIONS__GITHUB__APP__CLIENT_ID=
# INTEGRATIONS__GITHUB__APP__CLIENT_SECRET=
# INTEGRATIONS__GITHUB__APP__PRIVATE_KEY_PEM=

# Google Workspace.
# INTEGRATIONS__GOOGLE__ENABLED=true
