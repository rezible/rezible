{
  "$schema": "https://raw.githubusercontent.com/jetpack-io/devbox/0.17.0/.schema/devbox.schema.json",
  "packages": {
    "bun":                         "latest",
    "just":                        "latest",
    "github:peterldowns/localias": "",
    "wget":                        "latest",
    "go":                          "latest",
    "process-compose":             "latest"
  },
  "env_from": ".env",
  "env": {
    "JUST_TEMPDIR": "/tmp"
  },
  "shell": {
    "init_hook": [
      "unset DEVELOPER_DIR",
      "[[ ! -f \"$DEVBOX_PROJECT_ROOT/devenv/.workspace-env.sh\" ]] || . \"$DEVBOX_PROJECT_ROOT/devenv/.workspace-env.sh\""
    ],
    "scripts": {
      "setup": "just setup",
      "teardown": "just dev::cleanup-workspace"
    }
  }
}
