set shell := ["bash", "-euc"]

workspace_env_file := source_dir() / ".workspace-env.sh"
term_interactive := if env("TERM", "dumb") != "dumb" { "1" } else { "0" }

[doc("Run application services using Process Compose")]
[default]
[working-directory("..")]
@start *SERVICES="backend frontend documents": verify-workspace
    process-compose --no-server --disable-dotenv \
      -t={{term_interactive}} \
      -f {{ quote(source_dir() / "process-compose.apps.yaml") }} \
      up {{ SERVICES }}

backend: (start "backend")
frontend: (start "frontend")
documents: (start "documents")

[doc("Provision this workspace and apply migrations")]
@setup-workspace:
    bun --no-env-file scripts/workspace-env.ts
    source "{{ workspace_env_file }}" && just _provision

@_provision: && verify-workspace
    just ensure-localias
    just infra-up postgres dex
    just setup-database
    just _dex-client wait
    localias set "${AUTH_URL#https://}" "$DEX_PORT"
    just _dex-client ensure

[arg("force", long="force", value="true")]
[arg("no_migrate", long="no-migrate", value="true")]
@setup-database force="false" no_migrate="false":
    if {{ force }}; then bun --no-env-file scripts/database.ts drop; fi
    bun --no-env-file scripts/database.ts ensure
    if ! {{ no_migrate }}; then just --justfile ../Justfile backend::apply-migrations; fi

[doc("Verify workspace setup")]
@verify-workspace:
    just infra-up postgres dex
    bun --no-env-file scripts/database.ts verify
    just _dex-client wait

[doc("Remove this workspace's resources; leave shared infrastructure running")]
@cleanup-workspace:
    just _dex-client delete
    bun --no-env-file scripts/database.ts drop
    just unset-domains
    rm -f "{{ workspace_env_file }}"

source_checkout := parent_directory(`git rev-parse --path-format=absolute --git-common-dir`)
compose := 'docker compose --project-directory ' + quote(source_checkout) + ' -f ' + quote(source_checkout / 'docker-compose.yaml')
@_docker-compose *ARGS:
    docker compose --project-directory {{ quote(source_checkout) }} -f {{ quote(source_checkout / "docker-compose.yaml") }} {{ ARGS }}

[doc("Start shared infrastructure services and wait until healthy")]
@infra-up +SERVICES: _ensure-alertmanager-target
    just _docker-compose up -d --wait {{ SERVICES }}

# Shared Alertmanager reads its Rezible webhook URL from this gitignored file in the checkout that owns the
# shared infrastructure.
alertmanager_target_dir := source_checkout / "devenv" / ".alertmanager"
alertmanager_target_file := alertmanager_target_dir / "webhook-url"
alertmanager_target_placeholder := "http://127.0.0.1:9/rezible-webhook-url-not-configured"

# Create the webhook URL file with a placeholder, so Alertmanager starts before a URL is configured.
@_ensure-alertmanager-target:
    mkdir -p {{ quote(alertmanager_target_dir) }}
    if [ ! -f {{ quote(alertmanager_target_file) }} ]; then \
      printf '%s\n' {{ quote(alertmanager_target_placeholder) }} > {{ quote(alertmanager_target_file) }}; \
    fi

[doc("Point the shared Alertmanager at a Rezible webhook URL from Alertmanager settings")]
alertmanager-target URL: _ensure-alertmanager-target
    #!/usr/bin/env bash
    set -euo pipefail
    url={{ quote(URL) }}
    if [[ ! "$url" =~ ^https?://([^/]+)((/[^/]+)*/webhooks/alertmanager/[^/]+)$ ]]; then
      echo "expected a Rezible Alertmanager webhook URL: https://<api host>/webhooks/alertmanager/<token>" >&2
      exit 1
    fi
    host="${BASH_REMATCH[1]}"
    path="${BASH_REMATCH[2]}"
    # The settings URL uses this worktree's HTTPS alias, which the container cannot resolve. Its Localias
    # mapping names the backend's port, which the container reaches through the host gateway.
    port="$(localias list | awk -v host="$host" '$1 == host && $2 == "->" { print $3 }')"
    if [ -z "$port" ]; then
      echo "no Localias mapping for $host; start the backend first" >&2
      exit 1
    fi
    origin="http://host.docker.internal:$port"
    printf '%s\n' "$origin$path" > {{ quote(alertmanager_target_file) }}
    echo "Alertmanager webhook target: $origin${path%/*}/<token>"
    if curl -fsS -X POST "http://localhost:${ALERTMANAGER_PORT}/-/reload" >/dev/null 2>&1; then
      echo "Reloaded Alertmanager."
    else
      echo "Could not reach Alertmanager on port ${ALERTMANAGER_PORT} to reload it; it reads the target when it starts."
    fi

[doc("Create (replacing any earlier one) or delete this workspace's Viewer token in the otel-lgtm Grafana")]
[arg("OPERATION", pattern="create|delete")]
@grafana-token OPERATION:
    bun --no-env-file scripts/grafana-token.ts {{ OPERATION }}

[doc("Stop named shared infrastructure services; affects all worktrees")]
@infra-stop +SERVICES:
    just _docker-compose stop {{ SERVICES }}

[arg("OPERATION", pattern="wait|ensure|delete")]
[working-directory("scripts/dex-client")]
@_dex-client OPERATION:
    go run . {{ OPERATION }}

@ensure-localias:
    cp "$(localias debug cert)" ./localias-ca.crt
    if ! localias status | grep -q 'daemon running'; then localias start; fi

@unset-domains:
    localias rm "${APP_URL#https://}" "${API_URL#https://}" "${DOCUMENTS_URL#https://}"
