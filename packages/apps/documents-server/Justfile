set shell := ["bash", "-uc"]

_default:
    @just --list

build:
    bun run build

test:
    bun run test

@dev:
    DB_URL="postgresql://${POSTGRES_APP_USER}:${POSTGRES_APP_USER}@localhost:${POSTGRES_PORT}/${POSTGRES_APP_DB}?sslmode=disable" \
    PORT="${DOCUMENTS_PORT}" \
      bun --no-env-file run dev

@run *ARGS:
    bun run {{ ARGS }}
