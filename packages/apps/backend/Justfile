set shell := ["bash", "-uc"]

_default:
    @just --list

install:
    go mod download

format:
    go fmt ./...

export HTTP__PORT := env("BACKEND_PORT", "")

[env("HTTP__AUTH__ENABLE_DEV_SKIP_AUTH", "false")]
@dev:
    go tool reflex --decoration=none -r '\.go' -s -- sh -c 'go run ./cmd/rezible serve'


@run *ARGS:
    go run ./cmd/rezible {{ ARGS }}

@test *ARGS:
    POSTGRES__HOST="${POSTGRES_TEST_HOST}" \
      POSTGRES__PORT="${POSTGRES_TEST_PORT}" \
      POSTGRES__DATABASE="${POSTGRES_TEST_DB}" \
      go test {{ ARGS }}

exclude_test_packages_pattern := "/ent/"

@test-all *ARGS:
    just test {{ ARGS }} $(go list ./... | grep -v '{{ exclude_test_packages_pattern }}')

@test-selection *ARGS:
    if [[ "{{ ARGS }}" == "" ]]; then just test-all; else just test {{ ARGS }}; fi

@test-package PACKAGE *ARGS:
    just test '{{ PACKAGE }}' {{ ARGS }}

@test-pattern PATTERN:
    just test $(go list ./... | grep -v '{{ exclude_test_packages_pattern }}') -run {{ PATTERN }}

@_genkit *ARGS:
    bunx genkit-cli@1.42.0 --no-update-notification {{ ARGS }}

[env("GENKIT_ENV", "dev")]
[env("GENKIT_REFLECTION_V2_SERVER", "true")]
[env("BACKEND_PORT", "7020")]
@run-genkit:
    just _genkit start --experimental-reflection-v2 -- just dev

@send-demo-webhook KIND="alert":
    curl -i -X POST "${API_URL:?Run just dev setup}/webhooks/demo" \
      -H "Content-Type: application/json" \
      -d '{"kind": "{{ KIND }}", "foo":"bar"}'

@codegen:
    go generate ./...

@gen-api:
    go generate ./pkg/openapi

@gen-schema:
    go generate ./ent

@gen-mocks:
    go generate ./test/mocks

@gen-migration NAME:
    just run migrations create '{{ NAME }}'

@apply-migrations:
    just run migrations apply

[working-directory(".")]
@create-initial-migration:
    rm -f ./internal/postgres/migrations/0001_init*.sql
    rm -f ./internal/postgres/migrations/atlas.sum
    just run migrations update-checksum
    just run migrations create init
    just run migrations update-checksum
