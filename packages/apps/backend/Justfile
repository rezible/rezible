set shell := ["bash", "-uc"]

_default:
    @just --list

install:
    go mod download

format:
    go fmt ./...

export HTTP__PORT := env("BACKEND_PORT", "")
export HTTP__AUTH__ENABLE_DEV_SKIP_MODE := env("SKIP_AUTH", "")
#export GENKIT_ENV := env("GENKIT_ENV", "dev")

@dev:
    go tool reflex --decoration=none -r '\.go' -s -- sh -c 'go run ./cmd/rezible serve'


@run *ARGS:
    go run ./cmd/rezible {{ ARGS }}

[positional-arguments]
@test *ARGS:
    POSTGRES__HOST="${POSTGRES_TEST_HOST}" \
      POSTGRES__PORT="${POSTGRES_TEST_PORT}" \
      POSTGRES__DATABASE="${POSTGRES_TEST_DB}" \
      go test "$@"

[positional-arguments]
@test-all *ARGS:
    just test "$@" $(go list -f '{{ "{{" }}if or .TestGoFiles .XTestGoFiles{{ "}}" }}{{ "{{" }}.ImportPath{{ "}}" }}{{ "{{" }}end{{ "}}" }}' ./...)

[positional-arguments]
@test-selection *ARGS:
    if [[ $# -eq 0 ]]; then just test-all; else just test "$@"; fi

[positional-arguments]
@test-package PACKAGE *ARGS:
    just test "$@"

@test-pattern PATTERN:
    just test-all -run {{ quote(PATTERN) }}

[doc("Run an AI evaluation target several times; results are written under .evals/")]
@eval TARGET RUNS="3":
    go run ./cmd/rezible ai evals run {{ quote(TARGET) }} --runs {{ RUNS }}

@_genkit *ARGS:
    bunx genkit-cli@1.42.0 --no-update-notification {{ ARGS }}

[env("GENKIT_ENV", "dev")]
[env("GENKIT_REFLECTION_V2_SERVER", "true")]
[env("BACKEND_PORT", "7020")]
@run-genkit:
    just _genkit start --experimental-reflection-v2 -- go run ./cmd/rezible serve

@send-demo-webhook KIND="alert":
    curl -i -X POST "${API_URL:?Run just dev setup}/webhooks/demo" \
      -H "Content-Type: application/json" \
      -d '{"kind": "{{ KIND }}", "foo":"bar"}'

@generate *ARGS:
    GOFLAGS="${GOFLAGS:+$GOFLAGS }-p=1" GOMAXPROCS=2 GOMEMLIMIT=3GiB go generate {{ ARGS }}

codegen: (generate "./...")

gen-api: (generate "./pkg/openapi")

gen-schema: (generate "./ent")

gen-mocks: (generate "./test/mocks")

[doc("Regenerate Ent and write the next migration from the schema diff")]
@gen-migration NAME:
    just gen-schema
    just run migrations create '{{ NAME }}'

[doc("Apply pending migrations to this workspace's database")]
@apply-migrations:
    just run migrations apply

[doc("Rewrite atlas.sum after editing a migration file")]
@migrations-checksum:
    just run migrations update-checksum

[doc("Show applied and pending migrations")]
@migrations-status:
    just run migrations status
