set shell := ["bash", "-uc"]

@_default:
    just --list

@build:
    bun run build

@dev:
    bun run dev

[positional-arguments]
@format *ARGS=".":
    bun run format "$@"

[doc("Lint selected frontend-relative paths using the shared ESLint cache.")]
[positional-arguments]
@lint +PATHS:
    bun run lint "$@"

[doc("Lint the whole frontend for CI or lint configuration changes.")]
@lint-all:
    bun run lint .

@run *ARGS:
    bun run {{ ARGS }}
